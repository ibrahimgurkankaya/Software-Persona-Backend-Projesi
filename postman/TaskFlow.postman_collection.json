{
  "info": {
    "name": "TaskFlow API",
    "description": "Gorev ve Proje Yonetim Sistemi REST API - Node.js Backend Programlama Bitirme Projesi",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "taskId", "value": "" }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/", "host": ["{{baseUrl}}"], "path": [""] }
      }
    },
    {
      "name": "Tasks - CRUD (Zorunlu)",
      "item": [
        {
          "name": "Create Task",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', body.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Backend API tasarla\",\n  \"description\": \"TaskFlow REST API endpointlerini tasarla\",\n  \"priority\": \"high\",\n  \"assignee\": \"musa\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          }
        },
        {
          "name": "Create Task - Invalid (400)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"title\": \"\"\n}" },
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          }
        },
        {
          "name": "List All Tasks",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/tasks", "host": ["{{baseUrl}}"], "path": ["tasks"] }
          }
        },
        {
          "name": "Get Task Detail",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Update Task",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"in-progress\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        },
        {
          "name": "Delete Task",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "{{taskId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "Tasks - Filtreleme ve Arama (Istege Bagli)",
      "item": [
        {
          "name": "Filter by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?status=completed",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "status", "value": "completed" }]
            }
          }
        },
        {
          "name": "Filter by Priority",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?priority=high",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "priority", "value": "high" }]
            }
          }
        },
        {
          "name": "Search by Keyword",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/search?keyword=backend",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "search"],
              "query": [{ "key": "keyword", "value": "backend" }]
            }
          }
        },
        {
          "name": "List by Assignee",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks/assignee/musa",
              "host": ["{{baseUrl}}"],
              "path": ["tasks", "assignee", "musa"]
            }
          }
        },
        {
          "name": "Pagination",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Sort by createdAt",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/tasks?sort=createdAt",
              "host": ["{{baseUrl}}"],
              "path": ["tasks"],
              "query": [{ "key": "sort", "value": "createdAt" }]
            }
          }
        }
      ]
    },
    {
      "name": "Reports (Istege Bagli)",
      "item": [
        {
          "name": "Completed Tasks Report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/completed", "host": ["{{baseUrl}}"], "path": ["reports", "completed"] }
          }
        },
        {
          "name": "Pending Tasks Report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/pending", "host": ["{{baseUrl}}"], "path": ["reports", "pending"] }
          }
        },
        {
          "name": "Summary Report",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/reports/summary", "host": ["{{baseUrl}}"], "path": ["reports", "summary"] }
          }
        }
      ]
    }
  ]
}
